FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY core_model/requirements.txt /tmp/core_req.txt
COPY backend/requirements.txt /tmp/backend_req.txt

RUN pip install --no-cache-dir -r /tmp/core_req.txt && \
    pip install --no-cache-dir -r /tmp/backend_req.txt

COPY core_model/ /app/core_model/
COPY backend/ /app/backend/

ENV PYTHONPATH=/app

RUN mkdir -p /app/uploads /app/results /app/task_status

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
