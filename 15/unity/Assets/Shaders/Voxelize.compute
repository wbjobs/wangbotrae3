#pragma kernel Voxelize

struct VoxelData
{
    uint Active;
    float Strength;
    float3 Velocity;
    float Pressure;
    float Stress;
};

RWStructuredBuffer<VoxelData> Voxels;
StructuredBuffer<float3> Vertices;
StructuredBuffer<int> Triangles;

int GridSize;
float VoxelSize;
float DefaultStrength;
matrix LocalToGrid;
int TriangleCount;

[numthreads(8, 8, 8)]
void Voxelize(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= GridSize || id.y >= GridSize || id.z >= GridSize)
        return;

    int voxelIndex = id.x + id.y * GridSize + id.z * GridSize * GridSize;

    float3 voxelCenter = float3(id.x, id.y, id.z) + 0.5f;
    float3 voxelMin = voxelCenter - 0.5f;
    float3 voxelMax = voxelCenter + 0.5f;

    bool inside = false;

    for (int tri = 0; tri < TriangleCount; tri++)
    {
        int3 triIndices = int3(
            Triangles[tri * 3 + 0],
            Triangles[tri * 3 + 1],
            Triangles[tri * 3 + 2]
        );

        float3 v0 = mul(LocalToGrid, float4(Vertices[triIndices.x], 1.0)).xyz;
        float3 v1 = mul(LocalToGrid, float4(Vertices[triIndices.y], 1.0)).xyz;
        float3 v2 = mul(LocalToGrid, float4(Vertices[triIndices.z], 1.0)).xyz;

        if (IntersectsAABB(voxelMin, voxelMax, v0, v1, v2))
        {
            inside = true;
            break;
        }
    }

    if (inside)
    {
        Voxels[voxelIndex].Active = 1;
        Voxels[voxelIndex].Strength = DefaultStrength;
        Voxels[voxelIndex].Velocity = float3(0, 0, 0);
        Voxels[voxelIndex].Pressure = 0;
        Voxels[voxelIndex].Stress = 0;
    }
}

bool IntersectsAABB(float3 bmin, float3 bmax, float3 v0, float3 v1, float3 v2)
{
    float3 tmin = min(min(v0, v1), v2);
    float3 tmax = max(max(v0, v1), v2);

    if (tmax.x < bmin.x || tmin.x > bmax.x) return false;
    if (tmax.y < bmin.y || tmin.y > bmax.y) return false;
    if (tmax.z < bmin.z || tmin.z > bmax.z) return false;

    float3 c = (bmin + bmax) * 0.5f;
    float3 e = (bmax - bmin) * 0.5f;

    v0 -= c; v1 -= c; v2 -= c;

    float3 f0 = v1 - v0;
    float3 f1 = v2 - v1;
    float3 f2 = v0 - v2;

    float3 a00 = float3(0, -f0.z, f0.y);
    float3 a01 = float3(0, -f1.z, f1.y);
    float3 a02 = float3(0, -f2.z, f2.y);
    float3 a10 = float3(f0.z, 0, -f0.x);
    float3 a11 = float3(f1.z, 0, -f1.x);
    float3 a12 = float3(f2.z, 0, -f2.x);
    float3 a20 = float3(-f0.y, f0.x, 0);
    float3 a21 = float3(-f1.y, f1.x, 0);
    float3 a22 = float3(-f2.y, f2.x, 0);

    float p0 = dot(v0, a00);
    float p1 = dot(v1, a00);
    float p2 = dot(v2, a00);
    float r = e.y * abs(f0.z) + e.z * abs(f0.y);
    if (max(-max(max(p0, p1), p2), min(min(p0, p1), p2)) > r) return false;

    p0 = dot(v0, a01); p1 = dot(v1, a01); p2 = dot(v2, a01);
    r = e.y * abs(f1.z) + e.z * abs(f1.y);
    if (max(-max(max(p0, p1), p2), min(min(p0, p1), p2)) > r) return false;

    p0 = dot(v0, a02); p1 = dot(v1, a02); p2 = dot(v2, a02);
    r = e.y * abs(f2.z) + e.z * abs(f2.y);
    if (max(-max(max(p0, p1), p2), min(min(p0, p1), p2)) > r) return false;

    p0 = dot(v0, a10); p1 = dot(v1, a10); p2 = dot(v2, a10);
    r = e.x * abs(f0.z) + e.z * abs(f0.x);
    if (max(-max(max(p0, p1), p2), min(min(p0, p1), p2)) > r) return false;

    p0 = dot(v0, a11); p1 = dot(v1, a11); p2 = dot(v2, a11);
    r = e.x * abs(f1.z) + e.z * abs(f1.x);
    if (max(-max(max(p0, p1), p2), min(min(p0, p1), p2)) > r) return false;

    p0 = dot(v0, a12); p1 = dot(v1, a12); p2 = dot(v2, a12);
    r = e.x * abs(f2.z) + e.z * abs(f2.x);
    if (max(-max(max(p0, p1), p2), min(min(p0, p1), p2)) > r) return false;

    p0 = dot(v0, a20); p1 = dot(v1, a20); p2 = dot(v2, a20);
    r = e.x * abs(f0.y) + e.y * abs(f0.x);
    if (max(-max(max(p0, p1), p2), min(min(p0, p1), p2)) > r) return false;

    p0 = dot(v0, a21); p1 = dot(v1, a21); p2 = dot(v2, a21);
    r = e.x * abs(f1.y) + e.y * abs(f1.x);
    if (max(-max(max(p0, p1), p2), min(min(p0, p1), p2)) > r) return false;

    p0 = dot(v0, a22); p1 = dot(v1, a22); p2 = dot(v2, a22);
    r = e.x * abs(f2.y) + e.y * abs(f2.x);
    if (max(-max(max(p0, p1), p2), min(min(p0, p1), p2)) > r) return false;

    if (max(v0.x, max(v1.x, v2.x)) < -e.x || min(v0.x, min(v1.x, v2.x)) > e.x) return false;
    if (max(v0.y, max(v1.y, v2.y)) < -e.y || min(v0.y, min(v1.y, v2.y)) > e.y) return false;
    if (max(v0.z, max(v1.z, v2.z)) < -e.z || min(v0.z, min(v1.z, v2.z)) > e.z) return false;

    float3 normal = cross(f0, f1);
    float dist = dot(normal, v0);
    r = e.x * abs(normal.x) + e.y * abs(normal.y) + e.z * abs(normal.z);
    if (dist > r || dist < -r) return false;

    return true;
}
