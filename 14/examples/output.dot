digraph SparseMatrix {
    rankdir=LR;
    node [shape=circle, style=filled, fontsize=10];
    label="Sparse Matrix Visualization";
    r0 [label="r0", fillcolor="#a6cee3"];
    r1 [label="r1", fillcolor="#a6cee3"];
    r2 [label="r2", fillcolor="#a6cee3"];
    r3 [label="r3", fillcolor="#a6cee3"];
    r4 [label="r4", fillcolor="#a6cee3"];
    c0 [label="c0", fillcolor="#b2df8a"];
    c1 [label="c1", fillcolor="#b2df8a"];
    c2 [label="c2", fillcolor="#b2df8a"];
    c3 [label="c3", fillcolor="#b2df8a"];
    c4 [label="c4", fillcolor="#b2df8a"];
    r0 -> c0 [label="2.00", penwidth=3.0];
    r0 -> c2 [label="1.50", penwidth=2.5];
    r1 -> c1 [label="3.00", penwidth=4.0];
    r2 -> c0 [label="-1.00", penwidth=2.0];
    r2 -> c2 [label="4.00", penwidth=4.0];
    r3 -> c3 [label="2.50", penwidth=3.5];
    r4 -> c4 [label="1.00", penwidth=2.0];
}
